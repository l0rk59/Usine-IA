# ---------------------------------------------------------------------------
# Usine-IA — configuration
# Copiez ce fichier en « .env » puis collez vos cles. UNE SEULE SUFFIT.
# Le fichier .env n'est jamais versionne (voir .gitignore).
# ---------------------------------------------------------------------------

# --- Cles API gratuites, sans carte bancaire -------------------------------
# Le plus rapide. https://console.groq.com/keys
GROQ_API_KEY=

# Contexte 1M tokens, ideal pour les longs livres. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Tres rapide, quota journalier genereux. https://cloud.cerebras.ai/
CEREBRAS_API_KEY=

# Excellent en francais. https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=

# Beaucoup de modeles :free, environ 50 requetes/jour. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Token GitHub classique avec le scope models:read. https://github.com/settings/tokens
GITHUB_MODELS_TOKEN=

# Credits gratuits renouveles. https://build.nvidia.com/
NVIDIA_API_KEY=

# Facultatif : augmente les quotas de Pollinations (qui marche deja sans rien).
POLLINATIONS_TOKEN=

# --- IA locale (dernier recours, fonctionne hors ligne) --------------------
# ollama : pkg install ollama && ollama serve && ollama pull qwen2.5:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_MODEL_RAPIDE=qwen2.5:0.5b

# llama.cpp : llama-server -m modele.gguf --port 8080
LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1

# --- Reglages de l'usine ---------------------------------------------------
# Ordre de bascule entre fournisseurs (les locaux passent toujours en dernier).
# USINE_PROVIDERS=groq,gemini,mistral,pollinations

# Mettre a 1 pour privilegier l'IA locale avant les API distantes.
# USINE_LOCAL_FIRST=0

# Dossier de sortie. Sur Termux, pour ecrire dans la memoire du telephone :
# USINE_HOME=/sdcard/Usine-IA
# USINE_HOME=

# Traces completes en cas d'erreur.
# USINE_DEBUG=0
