+void D3D12CommandProcessor::UsrCaptureRecord(ID3D12Resource* guest_output,
+                                             uint32_t width,
+                                             uint32_t height) {
+  if (usr_capture_sequences_ >= kUsrCaptureMaxSequences) {
+    return;
+  }
+  // La decoupe se decime en 3x3 phases : seule l'echelle 3 le permet.
+  if (texture_cache_->draw_resolution_scale_x() != kUsrCaptureScale ||
+      texture_cache_->draw_resolution_scale_y() != kUsrCaptureScale ||
+      width < kUsrCaptureWidth || height < kUsrCaptureHeight) {
+    if (!usr_capture_warned_) {
+      XELOGW(
+          "USR capture : rien n'est enregistre -- il faut "
+          "draw_resolution_scale_x = draw_resolution_scale_y = {} (image "
+          "{}x{})",
+          kUsrCaptureScale, width, height);
+      usr_capture_warned_ = true;
+    }
+    return;
+  }
+  if (!usr_capture_file_) {
+    if (usr_capture_gap_left_) {
+      --usr_capture_gap_left_;
+      return;
+    }
+    // Nouvelle sequence : fichier, tampons, position de la decoupe.
+    ID3D12Device* device = GetD3D12Provider().GetDevice();
+    D3D12_RESOURCE_DESC crop_desc = {};
+    crop_desc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    crop_desc.Width = kUsrCaptureWidth;
+    crop_desc.Height = kUsrCaptureHeight;
+    crop_desc.DepthOrArraySize = 1;
+    crop_desc.MipLevels = 1;
+    crop_desc.Format = ui::d3d12::D3D12Presenter::kGuestOutputFormat;
+    crop_desc.SampleDesc.Count = 1;
+    UINT64 buffer_size = 0;
+    device->GetCopyableFootprints(&crop_desc, 0, 1, 0,
+                                  &usr_capture_footprint_, nullptr, nullptr,
+                                  &buffer_size);
+    for (UsrCaptureSlot& slot : usr_capture_slots_) {
+      if (slot.buffer) {
+        continue;
+      }
+      D3D12_RESOURCE_DESC buffer_desc;
+      ui::d3d12::util::FillBufferResourceDesc(buffer_desc, buffer_size,
+                                              D3D12_RESOURCE_FLAG_NONE);
+      if (FAILED(device->CreateCommittedResource(
+              &ui::d3d12::util::kHeapPropertiesReadback,
+              D3D12_HEAP_FLAG_NONE, &buffer_desc,
+              D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+              IID_PPV_ARGS(&slot.buffer)))) {
+        XELOGE("USR capture : echec de creation des tampons de relecture");
+        UsrCaptureShutdown();
+        usr_capture_sequences_ = kUsrCaptureMaxSequences;
+        return;
+      }
+    }
+    // Decoupe alignee sur l'echelle : les phases de la decimation restent
+    // celles des pixels a l'echelle 1.
+    auto random_cell = [this](uint32_t cells) -> uint32_t {
+      usr_capture_random_ = usr_capture_random_ * 1664525u + 1013904223u;
+      return cells ? (usr_capture_random_ >> 8) % cells : 0;
+    };
+    const uint32_t crop_x =
+        random_cell((width - kUsrCaptureWidth) / kUsrCaptureScale + 1) *
+        kUsrCaptureScale;
+    const uint32_t crop_y =
+        random_cell((height - kUsrCaptureHeight) / kUsrCaptureScale + 1) *
+        kUsrCaptureScale;
+    std::filesystem::path folder =
+        kernel_state_->emulator()->storage_root() / "usr_captures";
+    std::error_code error;
+    std::filesystem::create_directories(folder, error);
+    const std::string name = fmt::format(
+        "usrc_{:08X}_{}_{:02}.bin", kernel_state_->title_id(),
+        uint64_t(std::time(nullptr)), usr_capture_sequences_);
+    usr_capture_file_ = xe::filesystem::OpenFile(folder / name, "wb");
+    if (!usr_capture_file_) {
+      XELOGE("USR capture : impossible d'ecrire dans {}",
+             xe::path_to_utf8(folder));
+      usr_capture_sequences_ = kUsrCaptureMaxSequences;
+      return;
+    }
+    // En-tete : 10 entiers de 32 bits (docs/CAPTURE.md).
+    const uint32_t header[10] = {
+        0x43525355u,  // 'USRC'
+        1u,
+        kUsrCaptureWidth,
+        kUsrCaptureHeight,
+        kUsrCaptureScale,
+        kUsrCaptureScale,
+        uint32_t(ui::d3d12::D3D12Presenter::kGuestOutputFormat),
+        kUsrCaptureFrames,
+        crop_x,
+        crop_y,
+    };
+    std::fwrite(header, sizeof(header), 1, usr_capture_file_);
+    usr_capture_recorded_ = 0;
+    usr_capture_written_ = 0;
+    // Position de la decoupe gardee pour toute la sequence.
+    usr_capture_footprint_.Offset = 0;
+    usr_capture_crop_x_ = crop_x;
+    usr_capture_crop_y_ = crop_y;
+    XELOGI("USR capture : sequence {} -> {} (decoupe en {}, {})",
+           usr_capture_sequences_, name, crop_x, crop_y);
+  }
+  if (usr_capture_recorded_ >= kUsrCaptureFrames) {
+    return;  // en attente de l'ecriture des dernieres images
+  }
+  // Le tampon de cette image doit etre libre : ecrire (en attendant le GPU
+  // s'il le faut) les images plus anciennes, dans l'ordre.
+  UsrCaptureSlot& slot =
+      usr_capture_slots_[usr_capture_recorded_ % kUsrCaptureSlots];
+  while (usr_capture_written_ + kUsrCaptureSlots <= usr_capture_recorded_) {
+    UsrCaptureWrite(true);
+  }
+  PushTransitionBarrier(guest_output,
+                        ui::d3d12::D3D12Presenter::kGuestOutputInternalState,
+                        D3D12_RESOURCE_STATE_COPY_SOURCE);
+  SubmitBarriers();
+  D3D12_TEXTURE_COPY_LOCATION location_source, location_dest;
+  location_source.pResource = guest_output;
+  location_source.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+  location_source.SubresourceIndex = 0;
+  location_dest.pResource = slot.buffer.Get();
+  location_dest.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+  location_dest.PlacedFootprint = usr_capture_footprint_;
+  D3D12_BOX box;
+  box.left = usr_capture_crop_x_;
+  box.top = usr_capture_crop_y_;
+  box.front = 0;
+  box.right = usr_capture_crop_x_ + kUsrCaptureWidth;
+  box.bottom = usr_capture_crop_y_ + kUsrCaptureHeight;
+  box.back = 1;
+  deferred_command_list_.D3DCopyTextureRegion(&location_dest, 0, 0, 0,
+                                              &location_source, &box);
+  PushTransitionBarrier(guest_output, D3D12_RESOURCE_STATE_COPY_SOURCE,
+                        ui::d3d12::D3D12Presenter::kGuestOutputInternalState);
+  slot.submission = GetCurrentSubmission();
+  ++usr_capture_recorded_;
+}
+
+void D3D12CommandProcessor::UsrCaptureWrite(bool wait) {
+  while (usr_capture_file_ && usr_capture_written_ < usr_capture_recorded_) {
+    UsrCaptureSlot& slot =
+        usr_capture_slots_[usr_capture_written_ % kUsrCaptureSlots];
+    if (GetCompletedSubmission() < slot.submission) {
+      if (!wait) {
+        return;
+      }
+      CheckSubmissionCompletion(slot.submission);
+    }
+    void* mapping;
+    const D3D12_RANGE read_range = {
+        0, SIZE_T(usr_capture_footprint_.Footprint.RowPitch) *
+               kUsrCaptureHeight};
+    if (SUCCEEDED(slot.buffer->Map(0, &read_range, &mapping))) {
+      // Lignes jointives dans le fichier (le tampon les aligne sur 256).
+      for (uint32_t y = 0; y < kUsrCaptureHeight; ++y) {
+        std::fwrite(static_cast<const uint8_t*>(mapping) +
+                        size_t(y) * usr_capture_footprint_.Footprint.RowPitch,
+                    sizeof(uint32_t), kUsrCaptureWidth, usr_capture_file_);
+      }
+      const D3D12_RANGE written_range = {};
+      slot.buffer->Unmap(0, &written_range);
+    }
+    ++usr_capture_written_;
+    if (usr_capture_written_ >= kUsrCaptureFrames) {
+      std::fclose(usr_capture_file_);
+      usr_capture_file_ = nullptr;
+      ++usr_capture_sequences_;
+      usr_capture_gap_left_ = kUsrCaptureGap;
+      if (usr_capture_sequences_ >= kUsrCaptureMaxSequences) {
+        XELOGI("USR capture : {} sequences enregistrees, capture terminee",
+               usr_capture_sequences_);
+      }
+    }
+  }
+}
+
+void D3D12CommandProcessor::UsrCaptureShutdown() {
+  if (usr_capture_file_) {
+    // Une sequence interrompue garde ses images completes : la lecture
+    // (usr_ref) compte les images a la taille du fichier.
+    UsrCaptureWrite(true);
+    if (usr_capture_file_) {
+      std::fclose(usr_capture_file_);
+      usr_capture_file_ = nullptr;
+    }
+  }
+  for (UsrCaptureSlot& slot : usr_capture_slots_) {
+    slot.buffer.Reset();
+    slot.submission = 0;
+  }
+}
+
 void D3D12CommandProcessor::UsrBeginFrame(ui::Presenter* presenter) {
   usr_jitter_active_ = false;
   usr_lod_bias_active_ = false;
+  // Mode capture : l'image a l'echelle 3 doit etre rendue sans decalage,
+  // sinon la decimation en 3x3 phases ne tombe plus sur la grille.
+  if (cvars::usr_capture) {
+    return;
+  }
   if (!presenter || !presenter->IsUsrJitterRequested() ||
       !usr_output_image_width_ || !usr_output_image_height_) {
     return;
