@@ -912,6 +914,49 @@ class D3D12CommandProcessor final : public CommandProcessor {
   // Pour les samplers du dessin courant (biais de mip-map).
   bool usr_draw_jittered_ = false;
 
+  // USR, mode capture (usr_capture) : des sequences de l'image du jeu rendue
+  // a l'echelle 3 (draw_resolution_scale), sans jitter, pour entrainer USR
+  // sur de vrais jeux. Chaque image a l'echelle 3 contient les 9 images a
+  // l'echelle 1 que donnerait le jitter en grille 3x3 du niveau 2, et la
+  // verite terrain a la taille d'affichage (docs/CAPTURE.md).
+  // Decoupe : 384x216 pixels a l'echelle 3, soit 128x72 a l'echelle 1 --
+  // la taille des sequences d'entrainement au rapport 3 (usr_ref).
+  static constexpr uint32_t kUsrCaptureWidth = 384;
+  static constexpr uint32_t kUsrCaptureHeight = 216;
+  static constexpr uint32_t kUsrCaptureScale = 3;
+  // 48 images consecutives par sequence : 16 Mo en 10 bits par canal, sous
+  // la limite de 25 Mo d'un envoi de fichier par le site de GitHub.
+  static constexpr uint32_t kUsrCaptureFrames = 48;
+  // Images du jeu entre deux sequences (10 s a 30 images/s) : des scenes
+  // differentes plutot que 40 fois la meme.
+  static constexpr uint32_t kUsrCaptureGap = 300;
+  static constexpr uint32_t kUsrCaptureMaxSequences = 40;
+  static constexpr uint32_t kUsrCaptureSlots = 4;
+  struct UsrCaptureSlot {
+    Microsoft::WRL::ComPtr<ID3D12Resource> buffer;
+    uint64_t submission = 0;
+  };
+  // Dans la mise a jour de l'image du jeu (sous-mission ouverte) : copie
+  // de la decoupe vers un tampon de relecture.
+  void UsrCaptureRecord(ID3D12Resource* guest_output, uint32_t width,
+                        uint32_t height);
+  // Ecrit dans le fichier les images copiees dont le GPU a fini ; toutes,
+  // en attendant le GPU, si « wait ».
+  void UsrCaptureWrite(bool wait);
+  void UsrCaptureShutdown();
+  std::array<UsrCaptureSlot, kUsrCaptureSlots> usr_capture_slots_;
+  D3D12_PLACED_SUBRESOURCE_FOOTPRINT usr_capture_footprint_ = {};
+  FILE* usr_capture_file_ = nullptr;
+  // Images de la sequence en cours copiees, et ecrites.
+  uint32_t usr_capture_recorded_ = 0;
+  uint32_t usr_capture_written_ = 0;
+  uint32_t usr_capture_gap_left_ = 0;
+  uint32_t usr_capture_sequences_ = 0;
+  uint32_t usr_capture_random_ = 0x55535243u;
+  uint32_t usr_capture_crop_x_ = 0;
+  uint32_t usr_capture_crop_y_ = 0;
+  bool usr_capture_warned_ = false;
+
   std::atomic<bool> pix_capture_requested_ = false;
   bool pix_capturing_;
 
