+    if (generate) {
+      barrier_count = 0;
+      transition(usr_previous_output_.Get(), usr_previous_output_state_,
+                 kUsrReadState);
+      transition(usr_generated_.Get(), usr_generated_state_,
+                 D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+      if (barrier_count) {
+        command_list->ResourceBarrier(barrier_count, barriers);
+      }
+      usr_previous_output_state_ = kUsrReadState;
+      usr_generated_state_ = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+      usr::UniversalInterpolateDesc interpolate_desc = {};
+      interpolate_desc.commandList = command_list;
+      interpolate_desc.previous = usr_previous_output_.Get();
+      interpolate_desc.current = usr_output_.Get();
+      interpolate_desc.output = usr_generated_.Get();
+      interpolate_desc.previousFormat = kUsrOutputFormat;
