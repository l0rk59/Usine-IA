+bool D3D12Presenter::UsrEnsureGenerationTextures() {
+  if (usr_previous_output_ && usr_generated_) {
+    return true;
+  }
+  if (!usr_output_) {
+    return false;
+  }
+  D3D12_RESOURCE_DESC texture_desc = usr_output_->GetDesc();
+  ID3D12Device* device = provider_.GetDevice();
+  if (FAILED(device->CreateCommittedResource(
+          &util::kHeapPropertiesDefault,
+          provider_.GetHeapFlagCreateNotZeroed(), &texture_desc,
+          D3D12_RESOURCE_STATE_UNORDERED_ACCESS, nullptr,
+          IID_PPV_ARGS(&usr_previous_output_))) ||
+      FAILED(device->CreateCommittedResource(
+          &util::kHeapPropertiesDefault,
+          provider_.GetHeapFlagCreateNotZeroed(), &texture_desc,
+          D3D12_RESOURCE_STATE_UNORDERED_ACCESS, nullptr,
+          IID_PPV_ARGS(&usr_generated_)))) {
+    XELOGE("USR: echec de creation des textures de generation d'images");
+    usr_previous_output_.Reset();
+    usr_generated_.Reset();
+    return false;
+  }
+  usr_previous_output_state_ = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+  usr_generated_state_ = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+  usr_previous_valid_ = false;
+  return true;
+}
