+        usr_present_on_vblank_ = false;
+      }
+    }
+    // Une coupure (reset) rend la sortie precedente etrangere a celle-ci ;
+    // la bibliotheque le sait aussi (NotReady), ceci garde la texture.
+    usr_previous_valid_ = keep_previous && !dispatch_desc.reset;
+
     // L'image du jeu lue par USR doit vivre jusqu'a la fin de cette peinture.
     size_t ref_index = 0;
     const uint64_t completed = paint_context_.paint_completion_timeline
@@ -302,6 +398,9 @@ ID3D12Resource* D3D12Presenter::UsrUpscale(
         paint_submission, Microsoft::WRL::ComPtr<ID3D12Resource>(guest_output));
   }
   usr_last_usage_submission_ = paint_submission;
+  if (result_texture) {
