+/**
+ ******************************************************************************
+ * Xenia : Xbox 360 Emulator Research Project                                 *
+ ******************************************************************************
+ * USR (Usine Super Resolution) : reglages en direct a la manette.            *
+ * Released under the BSD license - see LICENSE in the root for more details. *
+ ******************************************************************************
+ */
+
+#ifndef XENIA_APP_USR_MENU_MODEL_H_
+#define XENIA_APP_USR_MENU_MODEL_H_
+
+// Modele du menu USR : lignes, valeurs, bornes, textes. Sans dependance a
+// Xenia ni a ImGui, teste a part (usr_menu_test.cc). La colle avec Xenia
+// (variables usr_*, configuration du presentateur, surcouche ImGui) est dans
+// usr_menu.h / usr_menu.cc.
+
+#include <cstdint>
+#include <cstdio>
+#include <string>
+
+namespace xe {
+namespace app {
+namespace usr_menu {
+
+enum class Method : int { kUsr, kFsr, kCas, kBilinear, kCount };
+
+struct Values {
+  Method method = Method::kUsr;
+  bool jitter = true;     // niveau 2 : jitter injecte dans la scene 3D
+  bool lod_bias = true;   // niveau 2 : textures plus fines
+  bool network = true;    // petit reseau de neurones
+  float network_strength = 1.0f;
+  float history_length = 10.0f;
+  float anti_ghosting = 0.3f;
+  float sharpness = 0.25f;
+  int debug_view = 0;     // 0 image, 1 carte de diagnostic
+  bool operator==(const Values&) const = default;
+};
+
+enum class Row : int {
+  kMethod,
+  kLevel,
+  kLodBias,
+  kNetwork,
+  kStrength,
+  kHistory,
+  kAntiGhosting,
+  kSharpness,
+  kDiagnostic,
+  kReset,
+  kCount
+};
+
+inline float Clampf(float v, float lo, float hi) {
+  return v < lo ? lo : (v > hi ? hi : v);
+}
+
+inline const char* MethodName(Method m) {
+  switch (m) {
+    case Method::kUsr:
+      return "USR";
+    case Method::kFsr:
+      return "FSR 1";
+    case Method::kCas:
+      return "CAS";
+    case Method::kBilinear:
+      return "Bilinéaire";
+    default:
+      return "?";
+  }
+}
+
+inline const char* RowLabel(Row r) {
+  switch (r) {
+    case Row::kMethod:
+      return "Méthode";
+    case Row::kLevel:
+      return "Niveau";
+    case Row::kLodBias:
+      return "Textures fines";
+    case Row::kNetwork:
+      return "IA";
+    case Row::kStrength:
+      return "Force de l'IA";
+    case Row::kHistory:
+      return "Historique";
+    case Row::kAntiGhosting:
+      return "Anti-fantômes";
+    case Row::kSharpness:
+      return "Netteté";
+    case Row::kDiagnostic:
+      return "Diagnostic";
+    case Row::kReset:
+      return "Oublier l'historique";
+    default:
+      return "?";
+  }
+}
+
+// Une ligne est-elle reglable avec les valeurs actuelles ? (Les reglages de
+// USR n'ont pas d'effet avec une autre methode, etc.)
+inline bool RowEnabled(const Values& v, Row r) {
+  const bool usr = v.method == Method::kUsr;
+  switch (r) {
+    case Row::kMethod:
+      return true;
+    case Row::kLodBias:
+      return usr && v.jitter;
+    case Row::kStrength:
+      return usr && v.network;
+    default:
+      return usr;
+  }
+}
+
+inline std::string RowValue(const Values& v, Row r) {
+  char buf[64];
+  switch (r) {
+    case Row::kMethod:
+      return MethodName(v.method);
+    case Row::kLevel:
+      return v.jitter ? "2 (jitter injecté)" : "1 (image telle quelle)";
+    case Row::kLodBias:
+      return v.lod_bias ? "oui" : "non";
+    case Row::kNetwork:
+      return v.network ? "oui" : "non (règles de base)";
+    case Row::kStrength:
+      std::snprintf(buf, sizeof(buf), "%.2f", v.network_strength);
+      return buf;
+    case Row::kHistory:
+      std::snprintf(buf, sizeof(buf), "%.0f images", v.history_length);
+      return buf;
+    case Row::kAntiGhosting:
+      std::snprintf(buf, sizeof(buf), "%.2f", v.anti_ghosting);
+      return buf;
+    case Row::kSharpness:
+      std::snprintf(buf, sizeof(buf), "%.0f %%", v.sharpness * 100.0f);
+      return buf;
+    case Row::kDiagnostic:
+      return v.debug_view ? "carte (R réactivité, V gain, B confiance)"
+                          : "image";
+    case Row::kReset:
+      return "A";
+    default:
+      return "";
+  }
+}
+
+// Modele du menu : selection et reglage a la croix / au stick.
+struct Menu {
+  int selected = 0;
+
+  void Move(int delta) {
+    const int n = int(Row::kCount);
+    selected = ((selected + delta) % n + n) % n;
+  }
+
+  Row SelectedRow() const { return Row(selected); }
+
+  // Gauche / droite. Renvoie vrai si une valeur a change.
+  bool Adjust(Values& v, int delta) const {
+    const Row r = SelectedRow();
+    if (!RowEnabled(v, r) || !delta) {
+      return false;
+    }
+    const Values before = v;
+    const int step = delta > 0 ? 1 : -1;
+    switch (r) {
+      case Row::kMethod: {
+        const int n = int(Method::kCount);
+        v.method = Method(((int(v.method) + step) % n + n) % n);
+      } break;
+      case Row::kLevel:
+        v.jitter = !v.jitter;
+        break;
+      case Row::kLodBias:
+        v.lod_bias = !v.lod_bias;
+        break;
+      case Row::kNetwork:
+        v.network = !v.network;
+        break;
+      case Row::kStrength:
+        v.network_strength =
+            Clampf(v.network_strength + 0.25f * float(step), 0.0f, 4.0f);
+        break;
+      case Row::kHistory: {
+        // pas de 1 jusqu'a 16, puis de 4
+        const float s = (v.history_length > 16.0f ||
+                         (v.history_length >= 16.0f && step > 0))
+                            ? 4.0f
+                            : 1.0f;
+        v.history_length =
+            Clampf(v.history_length + s * float(step), 1.0f, 64.0f);
+      } break;
+      case Row::kAntiGhosting: {
+        // echelle multiplicative, arrondie au centieme
+        const float f = step > 0 ? 1.25f : 0.8f;
+        const float x = Clampf(v.anti_ghosting * f, 0.05f, 4.0f);
+        v.anti_ghosting = float(int(x * 100.0f + 0.5f)) / 100.0f;
+      } break;
+      case Row::kSharpness:
+        v.sharpness = Clampf(v.sharpness + 0.05f * float(step), 0.0f, 1.0f);
+        break;
+      case Row::kDiagnostic:
+        v.debug_view = v.debug_view ? 0 : 1;
+        break;
+      default:
+        break;
+    }
+    return !(before == v);
+  }
+
+  // Bouton A. Renvoie vrai si l'historique doit etre oublie.
+  bool Activate(Values& v, bool& changed) const {
+    changed = false;
+    const Row r = SelectedRow();
+    if (r == Row::kReset) {
+      return RowEnabled(v, r);
+    }
+    // A sur une ligne a deux etats = la basculer.
+    if (r == Row::kLevel || r == Row::kLodBias || r == Row::kNetwork ||
+        r == Row::kDiagnostic) {
+      changed = Adjust(v, 1);
+    }
+    return false;
+  }
+};
+
+}  // namespace usr_menu
+}  // namespace app
+}  // namespace xe
+
+#endif  // XENIA_APP_USR_MENU_MODEL_H_
