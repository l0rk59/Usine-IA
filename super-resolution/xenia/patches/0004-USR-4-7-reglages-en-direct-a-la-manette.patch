+
+// Configuration du presentateur <-> valeurs du menu.
+Values FromConfig(const ui::Presenter::GuestOutputPaintConfig& config);
+void ToConfig(const Values& values, uint32_t reset_counter,
+              ui::Presenter::GuestOutputPaintConfig& config);
+
+// Variables de configuration usr_* -> reglages USR de la configuration (la
+// methode vient de postprocess_scaling_and_sharpening).
+void ApplyCvars(ui::Presenter::GuestOutputPaintConfig& config);
+// Valeurs -> variables de configuration, enregistrees dans le fichier.
+void SaveCvars(const Values& values);
+
+// Reglages avec les widgets ImGui classiques (fenetre d'affichage, PC).
+void DrawImGuiSettings(ui::Presenter::GuestOutputPaintConfig& config);
+
+// Surcouche en direct : le jeu continue et reste visible, la manette regle
+// USR. Vue + RB ouvre / ferme ; entrees du jeu bloquees tant qu'elle est
+// ouverte.
+class Overlay {
+ public:
+  // A appeler a chaque image de l'interface. other_menu_open : un autre menu
+  // (pause) a la main, la surcouche se ferme. Renvoie vrai si elle est
+  // ouverte.
+  bool Draw(ImGuiIO& io, ui::Presenter* presenter, bool other_menu_open);
+  void Open(ui::Presenter* presenter);
+  void Close(ui::Presenter* presenter);
+  bool is_open() const { return open_; }
+
+ private:
+  void Apply(ui::Presenter* presenter, bool comparing);
+
+  bool open_ = false;
+  bool comparing_ = false;
+  bool dirty_ = false;
+  Menu menu_;
+  Values values_;
+  uint32_t reset_counter_ = 0;
+};
+
