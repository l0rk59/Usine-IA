--- /dev/null
+++ b/src/xenia/app/usr_menu.cc
@@ -0,0 +1,344 @@
+/**
+ ******************************************************************************
+ * Xenia : Xbox 360 Emulator Research Project                                 *
+ ******************************************************************************
+ * USR (Usine Super Resolution) : reglages en direct a la manette.            *
+ * Released under the BSD license - see LICENSE in the root for more details. *
+ ******************************************************************************
+ */
+
+#include "xenia/app/usr_menu.h"
+
+#include <cmath>
+
+#include "third_party/imgui/imgui.h"
+#include "xenia/base/cvar.h"
+#include "xenia/config.h"
+
+DEFINE_bool(usr_jitter, true,
+            "USR : niveau 2 -- l'emulateur decale le rendu de la scene 3D "
+            "d'un jitter sous-pixel connu, ce qui permet a USR une vraie "
+            "super-resolution. Desactiver (niveau 1) si un jeu montre des "
+            "effets mal alignes ou un HUD qui tremble.",
+            "Display");
+DEFINE_bool(usr_lod_bias_enable, true,
+            "USR, niveau 2 : textures plus fines sur la scene 3D decalee "
+            "(biais de mip-map usr_lod_bias).",
+            "Display");
+DEFINE_bool(usr_network, true,
+            "USR : petit reseau de neurones (sinon regles de base seules, "
+            "nettement moins bonnes).",
+            "Display");
+DEFINE_double(usr_network_strength, 1.0,
+              "USR : influence du reseau, de 0 a 4 (1 = tel qu'entraine).",
+              "Display");
+DEFINE_double(usr_history_length, 10.0,
+              "USR : nombre maximal d'images accumulees, de 1 a 64.",
+              "Display");
+DEFINE_double(usr_anti_ghosting, 0.3,
+              "USR : seuil anti-fantomes, de 0.05 a 4 (petit = oublie vite "
+              "l'historique : moins de trainees, moins de detail).",
+              "Display");
+DEFINE_double(usr_sharpness, 0.25,
+              "USR : accentuation finale (RCAS), de 0 a 1.", "Display");
+
+namespace xe {
+namespace app {
+namespace usr_menu {
+
+using Effect = ui::Presenter::GuestOutputPaintConfig::Effect;
+
+namespace {
+
+Effect EffectForMethod(Method method) {
+  switch (method) {
+    case Method::kUsr:
+      return Effect::kUsr;
+    case Method::kFsr:
+      return Effect::kFsr;
+    case Method::kCas:
+      return Effect::kCas;
+    default:
+      return Effect::kBilinear;
+  }
+}
+
+Method MethodForEffect(Effect effect) {
+  switch (effect) {
+    case Effect::kUsr:
+      return Method::kUsr;
+    case Effect::kFsr:
+      return Method::kFsr;
+    case Effect::kCas:
+      return Method::kCas;
+    default:
+      return Method::kBilinear;
+  }
+}
+
+const char* CvarValueForMethod(Method method) {
+  switch (method) {
+    case Method::kUsr:
+      return "usr";
+    case Method::kFsr:
+      return "fsr";
+    case Method::kCas:
+      return "cas";
+    default:
+      return "";
+  }
+}
+
+}  // namespace
+
+Values FromConfig(const ui::Presenter::GuestOutputPaintConfig& config) {
+  const ui::Presenter::GuestOutputPaintConfig::UsrSettings& s =
+      config.GetUsrSettings();
+  Values v;
+  v.method = MethodForEffect(config.GetEffect());
+  v.jitter = s.jitter;
+  v.lod_bias = s.lod_bias;
+  v.network = s.network;
+  v.network_strength = s.network_strength;
+  v.history_length = s.history_length;
+  v.anti_ghosting = s.anti_ghosting;
+  v.sharpness = s.sharpness;
+  v.debug_view = int(s.debug_view);
+  return v;
+}
+
+void ToConfig(const Values& v, uint32_t reset_counter,
+              ui::Presenter::GuestOutputPaintConfig& config) {
+  config.SetEffect(EffectForMethod(v.method));
+  ui::Presenter::GuestOutputPaintConfig::UsrSettings s;
+  s.jitter = v.jitter;
+  s.lod_bias = v.lod_bias;
+  s.network = v.network;
+  s.network_strength = v.network_strength;
+  s.history_length = v.history_length;
+  s.anti_ghosting = v.anti_ghosting;
+  s.sharpness = v.sharpness;
+  s.debug_view = uint32_t(v.debug_view);
+  s.reset_counter = reset_counter;
+  config.SetUsrSettings(s);
+}
+
+void ApplyCvars(ui::Presenter::GuestOutputPaintConfig& config) {
+  ui::Presenter::GuestOutputPaintConfig::UsrSettings s =
+      config.GetUsrSettings();
+  s.jitter = cvars::usr_jitter;
+  s.lod_bias = cvars::usr_lod_bias_enable;
+  s.network = cvars::usr_network;
+  s.network_strength = float(cvars::usr_network_strength);
+  s.history_length = float(cvars::usr_history_length);
+  s.anti_ghosting = float(cvars::usr_anti_ghosting);
+  s.sharpness = float(cvars::usr_sharpness);
+  config.SetUsrSettings(s);
+}
+
+void SaveCvars(const Values& v) {
+  // postprocess_scaling_and_sharpening est definie dans emulator_window.cc :
+  // acces par la table des variables.
+  auto method_cvar =
+      cvar::ConfigVars->find("postprocess_scaling_and_sharpening");
+  if (method_cvar != cvar::ConfigVars->end()) {
+    auto* typed =
+        dynamic_cast<cvar::ConfigVar<std::string>*>(method_cvar->second);
+    if (typed) {
+      typed->OverrideConfigValue(CvarValueForMethod(v.method));
+    }
+  }
+  OVERRIDE_bool(usr_jitter, v.jitter);
+  OVERRIDE_bool(usr_lod_bias_enable, v.lod_bias);
+  OVERRIDE_bool(usr_network, v.network);
+  OVERRIDE_double(usr_network_strength, v.network_strength);
+  OVERRIDE_double(usr_history_length, v.history_length);
+  OVERRIDE_double(usr_anti_ghosting, v.anti_ghosting);
+  OVERRIDE_double(usr_sharpness, v.sharpness);
+  config::SaveConfig();
+}
+
+void DrawImGuiSettings(ui::Presenter::GuestOutputPaintConfig& config) {
+  ui::Presenter::GuestOutputPaintConfig::UsrSettings s =
+      config.GetUsrSettings();
+  ImGui::Checkbox("Niveau 2 : jitter injecté dans la scène 3D", &s.jitter);
+  ImGui::BeginDisabled(!s.jitter);
+  ImGui::Checkbox("Textures plus fines (biais de mip-map)", &s.lod_bias);
+  ImGui::EndDisabled();
+  ImGui::Checkbox("IA (petit réseau de neurones)", &s.network);
+  ImGui::BeginDisabled(!s.network);
+  ImGui::SliderFloat("Force de l'IA", &s.network_strength, 0.0f, 4.0f,
+                     "%.2f");
+  ImGui::EndDisabled();
+  ImGui::SliderFloat("Historique (images)", &s.history_length, 1.0f, 64.0f,
+                     "%.0f");
+  ImGui::SliderFloat("Anti-fantômes", &s.anti_ghosting, 0.05f, 4.0f, "%.2f",
+                     ImGuiSliderFlags_Logarithmic);
+  ImGui::SliderFloat("Netteté", &s.sharpness, 0.0f, 1.0f, "%.2f");
+  bool debug = s.debug_view != 0;
+  ImGui::Checkbox("Carte de diagnostic (R réactivité, V gain, B confiance)",
+                  &debug);
+  s.debug_view = debug ? 1 : 0;
+  if (ImGui::Button("Oublier l'historique")) {
+    ++s.reset_counter;
+  }
+  config.SetUsrSettings(s);
+}
+
+// --- Surcouche ---------------------------------------------------------------
+
+void Overlay::Open(ui::Presenter* presenter) {
+  if (open_ || !presenter) {
+    return;
+  }
+  open_ = true;
+  comparing_ = false;
+  dirty_ = false;
+  const ui::Presenter::GuestOutputPaintConfig& config =
+      presenter->GetGuestOutputPaintConfigFromUIThread();
+  values_ = FromConfig(config);
+  reset_counter_ = config.GetUsrSettings().reset_counter;
+}
+
+void Overlay::Close(ui::Presenter* presenter) {
+  if (!open_) {
+    return;
+  }
+  open_ = false;
+  if (presenter) {
+    // Fin d'une eventuelle comparaison : revenir aux reglages choisis.
+    Apply(presenter, false);
+  }
+  comparing_ = false;
+  if (dirty_) {
+    SaveCvars(values_);
+    dirty_ = false;
+  }
+}
+
+void Overlay::Apply(ui::Presenter* presenter, bool comparing) {
+  ui::Presenter::GuestOutputPaintConfig config =
+      presenter->GetGuestOutputPaintConfigFromUIThread();
+  ToConfig(values_, reset_counter_, config);
+  if (comparing) {
+    // A/B : l'autre methode (FSR si USR est choisi, USR sinon).
+    config.SetEffect(values_.method == Method::kUsr ? Effect::kFsr
+                                                    : Effect::kUsr);
+  }
+  presenter->SetGuestOutputPaintConfigFromUIThread(config);
+}
+
+bool Overlay::Draw(ImGuiIO& io, ui::Presenter* presenter,
+                   bool other_menu_open) {
+  (void)io;
+  // Vue maintenue + RB : ouvrir / fermer.
+  if (ImGui::IsKeyDown(ImGuiKey_GamepadBack) &&
+      ImGui::IsKeyPressed(ImGuiKey_GamepadR1, false)) {
+    if (open_) {
+      Close(presenter);
+    } else {
+      Open(presenter);
+    }
+  }
+  if (open_ && (other_menu_open || !presenter)) {
+    Close(presenter);
+  }
+  if (!open_) {
+    return false;
+  }
+
+  // --- Commandes ---
+  if (ImGui::IsKeyPressed(ImGuiKey_GamepadDpadUp, true)) {
+    menu_.Move(-1);
+  }
+  if (ImGui::IsKeyPressed(ImGuiKey_GamepadDpadDown, true)) {
+    menu_.Move(1);
+  }
+  bool changed = false;
+  if (ImGui::IsKeyPressed(ImGuiKey_GamepadDpadLeft, true)) {
+    changed |= menu_.Adjust(values_, -1);
+  }
+  if (ImGui::IsKeyPressed(ImGuiKey_GamepadDpadRight, true)) {
+    changed |= menu_.Adjust(values_, 1);
+  }
+  if (ImGui::IsKeyPressed(ImGuiKey_GamepadFaceDown, false)) {
+    bool toggled = false;
+    if (menu_.Activate(values_, toggled)) {
+      ++reset_counter_;
+      changed = true;
+    }
+    changed |= toggled;
+  }
+  if (ImGui::IsKeyPressed(ImGuiKey_GamepadFaceUp, false)) {
+    ++reset_counter_;  // Y : oublier l'historique
+    changed = true;
+  }
+  if (ImGui::IsKeyPressed(ImGuiKey_F12, false)) {
+    // X (transmis comme F12 par l'application UWP) : diagnostic
+    values_.debug_view = values_.debug_view ? 0 : 1;
+    changed = true;
+  }
+  if (ImGui::IsKeyPressed(ImGuiKey_GamepadFaceRight, false)) {
+    Close(presenter);  // B : fermer
+    return false;
+  }
+  const bool comparing = ImGui::IsKeyDown(ImGuiKey_GamepadL2);
+  if (changed || comparing != comparing_) {
+    comparing_ = comparing;
+    dirty_ = true;
+    Apply(presenter, comparing_);
+  }
+
+  // --- Affichage : petit panneau, le jeu reste visible et net ---
+  const ImGuiViewport* viewport = ImGui::GetMainViewport();
+  ImGui::SetNextWindowPos(
+      ImVec2(viewport->Pos.x + viewport->Size.x * 0.03f,
+             viewport->Pos.y + viewport->Size.y * 0.05f),
+      ImGuiCond_Always);
+  ImGui::SetNextWindowBgAlpha(0.72f);
+  const ImGuiWindowFlags flags =
+      ImGuiWindowFlags_NoTitleBar | ImGuiWindowFlags_NoResize |
+      ImGuiWindowFlags_NoMove | ImGuiWindowFlags_AlwaysAutoResize |
+      ImGuiWindowFlags_NoSavedSettings | ImGuiWindowFlags_NoNav |
+      ImGuiWindowFlags_NoFocusOnAppearing | ImGuiWindowFlags_NoInputs;
+  if (ImGui::Begin("##usr_overlay", nullptr, flags)) {
+    const ImVec4 accent(0.35f, 0.85f, 1.0f, 1.0f);
+    const ImVec4 normal(0.92f, 0.92f, 0.92f, 1.0f);
+    const ImVec4 selected(1.0f, 0.85f, 0.25f, 1.0f);
+    const ImVec4 disabled(0.5f, 0.5f, 0.5f, 1.0f);
+    ImGui::TextColored(accent, "USR - réglages en direct");
+    ImGui::Separator();
+    const float value_x = ImGui::GetFontSize() * 11.0f;
+    for (int i = 0; i < int(Row::kCount); ++i) {
+      const Row row = Row(i);
+      const bool is_selected = i == menu_.selected;
+      const ImVec4& color = !RowEnabled(values_, row)
+                                ? disabled
+                                : (is_selected ? selected : normal);
+      ImGui::TextColored(color, "%s %s", is_selected ? ">" : " ",
+                         RowLabel(row));
+      ImGui::SameLine(value_x);
+      ImGui::TextColored(color, "%s", RowValue(values_, row).c_str());
+    }
+    ImGui::Separator();
+    if (comparing_) {
+      ImGui::TextColored(selected, "Comparaison : %s (relâcher LT)",
+                         values_.method == Method::kUsr ? "FSR 1" : "USR");
+    }
+    uint32_t out_w = 0, out_h = 0;
+    presenter->GetUsrOutputSize(out_w, out_h);
+    if (values_.method == Method::kUsr && out_w && out_h) {
+      ImGui::TextColored(disabled, "Sortie USR : %u x %u", out_w, out_h);
+    }
+    ImGui::TextColored(disabled, "Croix : choisir, gauche / droite : régler");
+    ImGui::TextColored(disabled, "A : valider   Y : oublier l'historique");
+    ImGui::TextColored(disabled, "X : diagnostic   LT maintenue : comparer");
+    ImGui::TextColored(disabled, "B ou Vue + RB : fermer");
+  }
+  ImGui::End();
+  return true;
+}
+
+}  // namespace usr_menu
+}  // namespace app
+}  // namespace xe
