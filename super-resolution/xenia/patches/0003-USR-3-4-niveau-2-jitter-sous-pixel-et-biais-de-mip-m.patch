From 5cc5d9bd7c5ab649321605309780662d3b24e0de Mon Sep 17 00:00:00 2001
From: Usine-IA <usr@usine-ia.local>
Date: Mon, 28 Sep 2026 17:36:40 +0000
Subject: [PATCH 3/4] USR 3/4 : niveau 2, jitter sous-pixel et biais de mip-map

Quand USR est actif au niveau 2, le GPU emule decale la scene 3D d'un
jitter connu -- grille ordonnee 2x2 / 3x3 pour un rapport entier -- et, en
option, abaisse le niveau de mip-map de ses textures (usr_lod_bias).
Dessins decales : profondeur testee, vue aux proportions de l'image et de
40 a 105 % de sa taille, pre-passes de profondeur comprises (une passe
couleur en test d'egalite reste alignee). Le HUD, les passes plein ecran
sans profondeur, les cartes d'ombre et les petites vues ne bougent pas.
---
 .../gpu/d3d12/d3d12_command_processor.cc      | 90 +++++++++++++++++++
 src/xenia/gpu/d3d12/d3d12_command_processor.h | 24 +++++
 src/xenia/gpu/d3d12/d3d12_texture_cache.cc    |  8 +-
 src/xenia/gpu/d3d12/d3d12_texture_cache.h     |  2 +
 src/xenia/gpu/gpu_flags.cc                    |  9 ++
 src/xenia/gpu/gpu_flags.h                     |  2 +
 6 files changed, 133 insertions(+), 2 deletions(-)

diff --git a/src/xenia/gpu/d3d12/d3d12_command_processor.cc b/src/xenia/gpu/d3d12/d3d12_command_processor.cc
index fdbd5df..7c93109 100644
--- a/src/xenia/gpu/d3d12/d3d12_command_processor.cc
+++ b/src/xenia/gpu/d3d12/d3d12_command_processor.cc
@@ -30,6 +30,9 @@
 #include "xenia/ui/d3d12/d3d12_presenter.h"
 #include "xenia/ui/d3d12/d3d12_util.h"
 
+// USR -- Usine Super Resolution (third_party/usr) : suite de jitter.
+#include "usr/usr.h"
+
 DEFINE_bool(d3d12_bindless, true,
             "Use bindless resources where available - may improve performance, "
             "but may make debugging more complicated.",
@@ -2265,6 +2268,16 @@ void D3D12CommandProcessor::IssueSwap(uint32_t frontbuffer_ptr,
 
   auto aspect = graphics_system_->GetScaledAspectRatio();
 
+  // USR niveau 2 : le jitter utilise pour la scene 3D de cette image voyage
+  // avec elle jusqu'au presentateur.
+  presenter->SetNextGuestOutputUsrJitter(
+      usr_jitter_active_ ? usr_jitter_[0] : 0.0f,
+      usr_jitter_active_ ? usr_jitter_[1] : 0.0f);
+  usr_output_image_width_ = uint32_t(swap_texture_desc.Width);
+  usr_output_image_height_ = uint32_t(swap_texture_desc.Height);
+  usr_guest_frontbuffer_width_ = frontbuffer_width;
+  usr_guest_frontbuffer_height_ = frontbuffer_height;
+
   presenter->RefreshGuestOutput(
       uint32_t(swap_texture_desc.Width), uint32_t(swap_texture_desc.Height),
       aspect.first, aspect.second,
@@ -2586,6 +2599,72 @@ void D3D12CommandProcessor::IssueSwap(uint32_t frontbuffer_ptr,
   // End the frame even if did not present for any reason (the image refresher
   // was not called), to prevent leaking per-frame resources.
   EndSubmission(true);
+
+  // Jitter de l'image suivante.
+  UsrBeginFrame(presenter);
+}
+
+void D3D12CommandProcessor::UsrBeginFrame(ui::Presenter* presenter) {
+  usr_jitter_active_ = false;
+  usr_lod_bias_active_ = false;
+  if (!presenter || !presenter->IsUsrJitterRequested() ||
+      !usr_output_image_width_ || !usr_output_image_height_) {
+    return;
+  }
+  uint32_t output_width, output_height;
+  presenter->GetUsrOutputSize(output_width, output_height);
+  // Taille de sortie encore inconnue (aucune image peinte avec USR) ou pas
+  // d'agrandissement : pas de jitter.
+  if (output_width < usr_output_image_width_ ||
+      output_height < usr_output_image_height_) {
+    return;
+  }
+  float jitter_x, jitter_y;
+  usr::GetUniversalJitter(usr_jitter_frame_++, usr_output_image_width_,
+                          usr_output_image_height_, output_width,
+                          output_height, &jitter_x, &jitter_y);
+  usr_jitter_[0] = jitter_x;
+  usr_jitter_[1] = jitter_y;
+  // Le pixel i contient la scene vue en i + 0.5 + J : l'image se decale de
+  // -J pixels ; en NDC (Y vers le haut) : (-2 Jx / w, +2 Jy / h). Exprime en
+  // fraction de l'image finale, le decalage vaut pour toute cible de rendu
+  // qui la couvre, quelle que soit sa resolution.
+  usr_jitter_ndc_[0] = -2.0f * jitter_x / float(usr_output_image_width_);
+  usr_jitter_ndc_[1] = 2.0f * jitter_y / float(usr_output_image_height_);
+  usr_jitter_active_ = true;
+  usr_lod_bias_active_ = presenter->IsUsrLodBiasRequested();
+}
+
+bool D3D12CommandProcessor::UsrIsDrawJitterable(
+    reg::RB_DEPTHCONTROL normalized_depth_control,
+    const draw_util::ViewportInfo& viewport_info,
+    uint32_t draw_resolution_scale_x, uint32_t draw_resolution_scale_y) const {
+  // Scene 3D : profondeur testee, vue aux proportions de l'image (a 10 %
+  // pres) et de 40 a 105 % de sa taille dans chaque direction (les jeux
+  // « sous-HD » rendent leur scene plus petite que l'image finale).
+  // Les passes de profondeur seule (pre-passe) sont decalees comme la
+  // couleur : sinon une passe couleur en test « egal » perdrait des pixels.
+  // Exclus : passes plein ecran sans profondeur (post-traitements, HUD),
+  // cartes d'ombre (carrees ou plus grandes que l'image), petites vues
+  // (retroviseurs, cartes).
+  if (!usr_jitter_active_ || !normalized_depth_control.z_enable ||
+      !usr_guest_frontbuffer_width_ || !usr_guest_frontbuffer_height_) {
+    return false;
+  }
+  const uint64_t vw = viewport_info.xy_extent[0];
+  const uint64_t vh = viewport_info.xy_extent[1];
+  const uint64_t fw =
+      uint64_t(usr_guest_frontbuffer_width_) * draw_resolution_scale_x;
+  const uint64_t fh =
+      uint64_t(usr_guest_frontbuffer_height_) * draw_resolution_scale_y;
+  if (vw * 5 < fw * 2 || vh * 5 < fh * 2 || vw * 20 > fw * 21 ||
+      vh * 20 > fh * 21) {
+    return false;
+  }
+  // |vw / vh - fw / fh| <= 10 % de fw / fh
+  const uint64_t a = vw * fh;
+  const uint64_t b = fw * vh;
+  return (a > b ? a - b : b - a) * 10 <= b;
 }
 
 void D3D12CommandProcessor::OnPrimaryBufferEnd() {
@@ -2826,6 +2905,14 @@ bool D3D12CommandProcessor::IssueDraw(xenos::PrimitiveType primitive_type,
     previous_viewport_info_args_ = gviargs;
     previous_viewport_info_ = viewport_info;
   }
+  // USR niveau 2 : jitter sous-pixel de la scene 3D.
+  usr_draw_jittered_ =
+      UsrIsDrawJitterable(normalized_depth_control, viewport_info,
+                          draw_resolution_scale_x, draw_resolution_scale_y);
+  if (usr_draw_jittered_) {
+    viewport_info.ndc_offset[0] += usr_jitter_ndc_[0];
+    viewport_info.ndc_offset[1] += usr_jitter_ndc_[1];
+  }
   // todo: use SIMD for getscissor + scaling here, should reduce code size more
   draw_util::Scissor scissor;
   draw_util::GetScissor(regs, scissor);
@@ -5016,6 +5103,9 @@ bool D3D12CommandProcessor::UpdateBindings(const D3D12Shader* vertex_shader,
         }
         D3D12TextureCache::SamplerParameters parameters =
             texture_cache_->GetSamplerParameters(samplers_pixel_derefed[i]);
+        // USR niveau 2 : textures plus fines (biais de mip-map) sur la scene
+        // 3D decalee, l'accumulation absorbe le crenelage supplementaire.
+        parameters.usr_lod_bias = usr_draw_jittered_ && usr_lod_bias_active_;
         if (current_samplers_pixel_[i] != parameters) {
           current_samplers_pixel_[i] = parameters;
           cbuffer_binding_descriptor_indices_pixel_.up_to_date = false;
diff --git a/src/xenia/gpu/d3d12/d3d12_command_processor.h b/src/xenia/gpu/d3d12/d3d12_command_processor.h
index 83b0863..9367fbc 100644
--- a/src/xenia/gpu/d3d12/d3d12_command_processor.h
+++ b/src/xenia/gpu/d3d12/d3d12_command_processor.h
@@ -888,6 +888,30 @@ class D3D12CommandProcessor final : public CommandProcessor {
   draw_util::GetViewportInfoArgs previous_viewport_info_args_;
   draw_util::ViewportInfo previous_viewport_info_;
 
+  // USR (Usine Super Resolution), niveau 2 : jitter sous-pixel connu injecte
+  // dans le rendu de la scene 3D, image par image, et transmis au
+  // presentateur avec l'image. Calcule pour l'image suivante a chaque swap.
+  void UsrBeginFrame(ui::Presenter* presenter);
+  // Le dessin courant est-il decale (scene 3D) ?
+  bool UsrIsDrawJitterable(reg::RB_DEPTHCONTROL normalized_depth_control,
+                           const draw_util::ViewportInfo& viewport_info,
+                           uint32_t draw_resolution_scale_x,
+                           uint32_t draw_resolution_scale_y) const;
+  uint32_t usr_jitter_frame_ = 0;
+  bool usr_jitter_active_ = false;
+  bool usr_lod_bias_active_ = false;
+  // Jitter de l'image en cours, en pixels de l'image envoyee au presentateur
+  // (celle que USR agrandit), et decalage NDC correspondant.
+  float usr_jitter_[2] = {};
+  float usr_jitter_ndc_[2] = {};
+  // Taille de l'image envoyee au presentateur, et taille invitee de l'image.
+  uint32_t usr_output_image_width_ = 0;
+  uint32_t usr_output_image_height_ = 0;
+  uint32_t usr_guest_frontbuffer_width_ = 0;
+  uint32_t usr_guest_frontbuffer_height_ = 0;
+  // Pour les samplers du dessin courant (biais de mip-map).
+  bool usr_draw_jittered_ = false;
+
   std::atomic<bool> pix_capture_requested_ = false;
   bool pix_capturing_;
 
diff --git a/src/xenia/gpu/d3d12/d3d12_texture_cache.cc b/src/xenia/gpu/d3d12/d3d12_texture_cache.cc
index 1cc5ac1..0669e75 100644
--- a/src/xenia/gpu/d3d12/d3d12_texture_cache.cc
+++ b/src/xenia/gpu/d3d12/d3d12_texture_cache.cc
@@ -911,8 +911,12 @@ void D3D12TextureCache::WriteSampler(SamplerParameters parameters,
   desc.AddressU = kAddressModeMap[uint32_t(parameters.clamp_x)];
   desc.AddressV = kAddressModeMap[uint32_t(parameters.clamp_y)];
   desc.AddressW = kAddressModeMap[uint32_t(parameters.clamp_z)];
-  // LOD biasing is performed in shaders.
-  desc.MipLODBias = 0.0f;
+  // LOD biasing is performed in shaders. USR niveau 2 ajoute son biais aux
+  // textures de la scene 3D decalee (echantillonnage a LOD calcule).
+  desc.MipLODBias =
+      parameters.usr_lod_bias
+          ? std::min(0.0f, std::max(-2.0f, float(cvars::usr_lod_bias)))
+          : 0.0f;
   desc.ComparisonFunc = D3D12_COMPARISON_FUNC_NEVER;
   switch (parameters.border_color) {
     case xenos::BorderColor::k_ABGR_White:
diff --git a/src/xenia/gpu/d3d12/d3d12_texture_cache.h b/src/xenia/gpu/d3d12/d3d12_texture_cache.h
index 7f03443..5f9c3ec 100644
--- a/src/xenia/gpu/d3d12/d3d12_texture_cache.h
+++ b/src/xenia/gpu/d3d12/d3d12_texture_cache.h
@@ -62,6 +62,8 @@ class D3D12TextureCache final : public TextureCache {
       // Force the border color alpha to 1.0 (only meaningful with a border
       // clamp mode).
       uint32_t force_bc_w_to_max : 1;  // 23
+      // USR niveau 2 : biais de mip-map usr_lod_bias (scene 3D decalee).
+      uint32_t usr_lod_bias : 1;  // 24
       // Maximum mip level is in the texture resource itself, but mip_base_map
       // limits fetching to mip_min_level (level 0 when the base is available).
     };
