diff --git a/src/xenia/ui/presenter.h b/src/xenia/ui/presenter.h
index e85b6c3..ebaba06 100644
--- a/src/xenia/ui/presenter.h
+++ b/src/xenia/ui/presenter.h
@@ -201,6 +201,34 @@ class Presenter {
       // AMD FidelityFX Super Resolution upsampling, Contrast Adaptive
       // Sharpening otherwise.
       kFsr,
+      // USR (Usine Super Resolution), mode Universel : upscaler temporel qui
+      // estime lui-meme le mouvement (pas de vecteurs du jeu) et accumule les
+      // images, avec un petit reseau de neurones (third_party/usr). Les
+      // presentateurs qui ne le gerent pas se replient sur FSR.
+      kUsr,
+    };
+
+    // Reglages de USR, tous modifiables en direct (menu pause, surcouche).
+    struct UsrSettings {
+      // Niveau 2 : l'emulateur decale le rendu de la scene 3D d'un jitter
+      // sous-pixel connu (D3D12CommandProcessor), ce qui permet la vraie
+      // super-resolution. Niveau 1 (false) : l'image du jeu telle quelle.
+      bool jitter = false;
+      // Niveau 2 : biais de mip-map (textures plus fines) sur les dessins
+      // decales ; la valeur vient de la variable usr_lod_bias.
+      bool lod_bias = false;
+      // Petit reseau de neurones (false : regles de base seules).
+      bool network = true;
+      float network_strength = 1.0f;  // 0..4
+      float history_length = 10.0f;   // images, 1..64
+      float anti_ghosting = 0.3f;     // 0.05..4 (petit = oublie vite)
+      float sharpness = 0.25f;        // 0..1 (RCAS)
+      // Diagnostic : 0 image ; 1 carte des decisions de USR (rouge :
+      // reactivite, vert : gain, bleu : confiance de l'historique).
+      uint32_t debug_view = 0;
+      // Incremente pour demander l'oubli de l'historique.
+      uint32_t reset_counter = 0;
+      bool operator==(const UsrSettings&) const = default;
     };
 
     // This value is used as a lerp factor.
@@ -270,6 +298,20 @@ class Presenter {
     bool GetDither() const { return dither_; }
     void SetDither(bool new_dither) { dither_ = new_dither; }
 
+    const UsrSettings& GetUsrSettings() const { return usr_; }
+    void SetUsrSettings(const UsrSettings& new_usr) {
+      auto clampf = [](float v, float lo, float hi) {
+        // Comme les autres reglages : min / max elimine aussi les NaN.
+        return std::min(hi, std::max(lo, v));
+      };
+      usr_ = new_usr;
+      usr_.network_strength = clampf(usr_.network_strength, 0.0f, 4.0f);
+      usr_.history_length = clampf(usr_.history_length, 1.0f, 64.0f);
+      usr_.anti_ghosting = clampf(usr_.anti_ghosting, 0.05f, 4.0f);
+      usr_.sharpness = clampf(usr_.sharpness, 0.0f, 1.0f);
+      usr_.debug_view = std::min(usr_.debug_view, uint32_t(1));
+    }
+
    private:
     // Tools, rather than the emulator itself, must not allow overscan cutoff
